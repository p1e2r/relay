# Copy to .env and fill in what you need.

POSTGRES_PASSWORD=change-me
RELAY_PORT=8080
# RELAY_IMAGE=ghcr.io/p1e2r/relay-server:latest

# --- SMS for login codes (pick one; with none, codes are printed in the server log) ---
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Or any SMS gateway: Relay POSTs {"to","code","message"} as JSON
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTH=

# --- Calls ---
STUN_URLS=stun:stun.l.google.com:19302
# Own TURN relay (docker compose --profile turn up -d). Port-forward 3478 UDP/TCP and 49160-49200 UDP.
# TURN_URLS must point straight at your home IP or a DNS-only (grey cloud) hostname, never a proxied/tunnel one.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# Long random string shared by Relay and coturn; Relay hands out 24-hour credentials from it.
TURN_SECRET=
# Your public IP, or "public/private" if the NAS is behind your router, e.g. 203.0.113.7/192.168.1.20
TURN_EXTERNAL_IP=

MAX_UPLOAD_MB=100

# --- App store review account (optional) ---
# This number always accepts REVIEW_CODE and no SMS is sent. Give both to the store reviewer.
REVIEW_PHONE=
REVIEW_CODE=
